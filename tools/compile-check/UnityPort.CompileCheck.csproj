<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline compile check for UnityPort without a Unity Editor.
    Compiles every runtime script under UnityPort/Assets (Editor folders excluded) against the
    UnityEngine module reference assemblies from NuGet (UnityEngine.Modules 2021.3.x, the newest
    published there). Unity 2022.3 uses C# 9 on a .NET Standard 2.1 profile, mirrored here.
    APIs introduced after 2021.3 must be guarded with UNITY_2022_2_OR_NEWER, which is intentionally
    NOT defined here so the fallback branch is what gets compiled.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>CS0414;CS0649;CS0169;CS0219;CS0162;CS0168;CS0067</NoWarn>
    <DefineConstants>UNITY_STANDALONE;ENABLE_MONO</DefineConstants>
    <UnityRefDir Condition="'$(UnityRefDir)'==''">$(MSBuildThisFileDirectory)../.cache/unityengine.modules/lib/netstandard2.0</UnityRefDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../UnityPort/Assets/**/*.cs" Exclude="../../UnityPort/Assets/**/Editor/**/*.cs" />
    <Reference Include="$(UnityRefDir)/*.dll" />
  </ItemGroup>
</Project>
